-- RESPONSIVE (rotation / resize) --------------------------------------------
local lastVp = vp
cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    local nvp = cam.ViewportSize
    if nvp == lastVp then return end
    lastVp = nvp
    if closed then return end

    local newW = math.clamp(math.floor(nvp.X * 0.90), 300, 560)
    local newH = math.clamp(math.floor(nvp.Y * 0.82), 360, 520)
    TweenService:Create(Main, TweenInfo.new(0.25), { Size = UDim2.fromOffset(newW, newH) }):Play()
end)
