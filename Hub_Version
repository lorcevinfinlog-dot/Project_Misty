-- HELPERS -------------------------------------------------------------------
local closed  = false
local loading = false

local function closeHub()
    if closed then return end
    closed = true
    TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Size = UDim2.fromOffset(winW * 0.7, winH * 0.5), BackgroundTransparency = 1 }):Play()
    TweenService:Create(MainStroke, TweenInfo.new(0.22), { Transparency = 1 }):Play()
    TweenService:Create(Overlay, TweenInfo.new(0.22), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(blur, TweenInfo.new(0.22), { Size = 0 }):Play()
    task.delay(0.28, function()
        blur:Destroy()
        ScreenGui:Destroy()
    end)
end

CloseBtn.MouseButton1Click:Connect(closeHub)
CloseBtn.TouchTap:Connect(closeHub) -- для надёжности на мобиле

-- Escape on PC
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Escape and not closed then
        closeHub()
    end
end)

-- DRAG (mouse + touch) ------------------------------------------------------
local dragging, dragInput, dragStart, startPos
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging  = true
        dragStart = input.Position
        startPos  = Main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
Header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- CARD ----------------------------------------------------------------------
local function createCard(info, order)
    local Card = Instance.new("Frame")
    Card.Size             = UDim2.new(1, -6, 0, cardH)
    Card.BackgroundColor3 = Color3.fromRGB(30, 21, 36)
    Card.BorderSizePixel  = 0
    Card.LayoutOrder      = order
    Card.Parent           = List
    local cc2 = Instance.new("UICorner"); cc2.CornerRadius = UDim.new(0, 12); cc2.Parent = Card

    local CardStroke = Instance.new("UIStroke")
    CardStroke.Color        = Color3.fromRGB(80, 50, 70)
    CardStroke.Thickness    = 1
    CardStroke.Transparency = 0.4
    CardStroke.Parent       = Card

    local Accent = Instance.new("Frame")
    Accent.Size             = UDim2.new(0, 4, 1, -20)
    Accent.Position         = UDim2.fromOffset(10, 10)
    Accent.BackgroundColor3 = info.accent
    Accent.BorderSizePixel  = 0
    Accent.Parent           = Card
    local ac = Instance.new("UICorner"); ac.CornerRadius = UDim.new(1, 0); ac.Parent = Accent

    local Name = Instance.new("TextLabel")
    Name.Text              = info.label
    Name.Font              = Enum.Font.GothamBold
    Name.TextSize          = nameSize
    Name.TextColor3        = Color3.fromRGB(250, 240, 250)
    Name.BackgroundTransparency = 1
    Name.TextXAlignment    = Enum.TextXAlignment.Left
    Name.Position          = UDim2.fromOffset(26, math.floor(cardH * 0.18))
    Name.Size              = UDim2.new(0.62, 0, 0, math.floor(24 * scale))
    Name.Parent            = Card

    local Desc = Instance.new("TextLabel")
    Desc.Text              = info.sub
    Desc.Font              = Enum.Font.Gotham
    Desc.TextSize          = descSize
    Desc.TextColor3        = Color3.fromRGB(155, 135, 160)
    Desc.BackgroundTransparency = 1
    Desc.TextXAlignment    = Enum.TextXAlignment.Left
    Desc.Position          = UDim2.fromOffset(26, math.floor(cardH * 0.54))
    Desc.Size              = UDim2.new(0.62, 0, 0, math.floor(20 * scale))
    Desc.Parent            = Card

    local Tag = Instance.new("Frame")
    Tag.Size                   = UDim2.fromOffset(78, math.floor(24 * scale))
    Tag.Position               = UDim2.new(1, -90, 0.5, -math.floor(12 * scale))
    Tag.BackgroundColor3       = info.accent
    Tag.BackgroundTransparency = 0.85
    Tag.BorderSizePixel        = 0
    Tag.Parent                 = Card
    local tcg = Instance.new("UICorner"); tcg.CornerRadius = UDim.new(0, 6); tcg.Parent = Tag
    local ts  = Instance.new("UIStroke"); ts.Color = info.accent; ts.Transparency = 0.4; ts.Parent = Tag
    local TagLabel = Instance.new("TextLabel")
    TagLabel.Text              = info.tag
    TagLabel.Font              = Enum.Font.GothamBold
    TagLabel.TextSize          = math.floor(11 * scale)
    TagLabel.TextColor3        = info.accent
    TagLabel.BackgroundTransparency = 1
    TagLabel.Size              = UDim2.fromScale(1, 1)
    TagLabel.Parent            = Tag

    local Btn = Instance.new("TextButton")
    Btn.Size                   = UDim2.fromScale(1, 1)
    Btn.BackgroundTransparency = 1
    Btn.Text                   = ""
    Btn.AutoButtonColor        = false
    Btn.Parent                 = Card

    -- Hover (PC)
    Btn.MouseEnter:Connect(function()
        TweenService:Create(Card, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(48, 30, 56) }):Play()
        TweenService:Create(CardStroke, TweenInfo.new(0.15), { Color = info.accent, Transparency = 0 }):Play()
    end)
    Btn.MouseLeave:Connect(function()
        TweenService:Create(Card, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(30, 21, 36) }):Play()
        TweenService:Create(CardStroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(80, 50, 70), Transparency = 0.4 }):Play()
    end)

    -- Touch feedback (mobile) — вспышка при касании
    Btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(Card, TweenInfo.new(0.08), { BackgroundColor3 = Color3.fromRGB(60, 34, 66) }):Play()
            TweenService:Create(CardStroke, TweenInfo.new(0.08), { Color = info.accent, Transparency = 0 }):Play()
        end
    end)
    Btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(Card, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(30, 21, 36) }):Play()
            TweenService:Create(CardStroke, TweenInfo.new(0.2), { Color = Color3.fromRGB(80, 50, 70), Transparency = 0.4 }):Play()
        end
    end)

    -- Launch
    Btn.MouseButton1Click:Connect(function()
        if loading or closed then return end
        loading = true
        Name.Text       = "▶ Launching " .. info.label .. "..."
        Name.TextColor3 = info.accent
        TweenService:Create(CardStroke, TweenInfo.new(0.2), { Color = info.accent, Transparency = 0 }):Play()
        TweenService:Create(Card, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(60, 34, 66) }):Play()

        task.wait(0.35)
        closeHub()
        task.wait(0.32)

        local success, err = pcall(function()
            loadstring(game:HttpGet(info.url))()
        end)
        if not success then
            warn("[Misty Dany Hub] Failed to load " .. info.label .. ": " .. tostring(err))
        end
    end)

    return Card
end

-- BUILD CARDS ---------------------------------------------------------------
for i, info in ipairs(CONFIG.Versions) do
    createCard(info, i)
end

